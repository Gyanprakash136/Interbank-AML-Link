# SignalMesh Environment Configuration
# Copy to .env and fill in values before running the application.
# Never commit .env to version control.

# ── Data directory ────────────────────────────────────────────────────────────
# Absolute or relative path to the root data directory.
# Default (when unset): <backend_root>/data/
SIGNALMESH_DATA_DIR=

# ── Application settings ─────────────────────────────────────────────────────
SIGNALMESH_ENV=development       # development | production
SIGNALMESH_LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR

# ── PSI protocol parameters ───────────────────────────────────────────────────
# False-positive rate for PSI setup messages (lower = larger setup message)
PSI_FALSE_POSITIVE_RATE=0.001

# ── API server (Stage 7+) ─────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── Database (Stage 7+) ───────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./signalmesh.db

# ── Security notes ────────────────────────────────────────────────────────────
# This stage uses explicitly documented synthetic canonical tokens (no HMAC).
# HMAC key derivation will be added in a later stage.
# PSI_HMAC_SECRET is intentionally absent from Stage 2.
